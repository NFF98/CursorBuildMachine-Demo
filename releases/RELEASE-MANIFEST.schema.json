{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NFF Release Manifest",
  "type": "object",
  "required": [
    "schema_version","release_id","status","build_spec_id","source_commit","sprint_ids",
    "approval","targets","health_checks","rollback"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "release_id": { "type": "string", "pattern": "^REL-P[0-9]+-[0-9]{3}$" },
    "status": { "const": "RELEASE_READY" },
    "build_spec_id": { "type": "string", "pattern": "^BS-P[0-9]+-[0-9]{3}$" },
    "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sprint_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^SP-P[0-9]+-[0-9]{3}$" }
    },
    "approval": {
      "type": "object",
      "required": ["status","decision_ref"],
      "properties": {
        "status": { "const": "USER_APPROVED" },
        "decision_ref": { "type": "string", "minLength": 1 }
      }
    },
    "targets": { "type": "array", "minItems": 1 },
    "health_checks": { "type": "array", "minItems": 1 },
    "rollback": { "type": "object" }
  },
  "additionalProperties": true
}
