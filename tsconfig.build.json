{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "rootDir": "."
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "generated/**/*.ts",
    "generated/**/*.tsx"
  ],
  "exclude": [
    "tests/**",
    "dist/**",
    "node_modules/**"
  ]
}
